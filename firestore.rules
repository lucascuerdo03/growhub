rules_version = '2';

// Reglas de GrowHub: huertos compartidos con roles y permisos.
// Pégalas en: Firebase Console > Firestore Database > Reglas > Publicar.
service cloud.firestore {
  match /databases/{database}/documents {

    function autenticado() {
      return request.auth != null;
    }
    function miEmail() {
      return request.auth.token.email.lower();
    }
    function emailVerificado() {
      return request.auth.token.email_verified == true;
    }
    function huertoDe(id) {
      return get(/databases/$(database)/documents/orchards/$(id)).data;
    }
    function esMiembroDe(h) {
      return h.ownerId == request.auth.uid || request.auth.uid in h.memberIds;
    }
    // La autoridad del propietario sale de ownerId, nunca del texto del rol: no
    // se puede conseguir escribiendo role: 'propietario' en el mapa de miembros.
    function esAdminDe(h) {
      return h.ownerId == request.auth.uid
        || h.members[request.auth.uid].role == 'administrador';
    }
    function tienePermiso(h, permiso) {
      return h.ownerId == request.auth.uid
        || h.members[request.auth.uid].permissions[permiso] == true;
    }
    // Debe coincidir con ROLES en src/utils/permissions.js.
    function permisosRol(role) {
      return role == 'administrador'
        ? { 'manageCrops': true, 'manageTasks': true, 'completeTasks': true,
            'manageSensors': true, 'publishPosts': true, 'inviteMembers': true }
        : role == 'colaborador'
          ? { 'manageCrops': true, 'manageTasks': true, 'completeTasks': true,
              'manageSensors': true, 'publishPosts': true, 'inviteMembers': false }
          : { 'manageCrops': false, 'manageTasks': false, 'completeTasks': false,
              'manageSensors': false, 'publishPosts': false, 'inviteMembers': false };
    }
    function miembrosCoherentes(d) {
      return d.members.keys().toSet() == d.memberIds.toSet();
    }

    // Perfil público mínimo. Se puede leer conociendo el uid, pero no listar:
    // así nadie puede sacar la lista de emails de todos los usuarios.
    match /users/{uid} {
      allow get: if autenticado();
      allow create, update: if autenticado() && request.auth.uid == uid
        && request.resource.data.email == miEmail();
    }

    // Foto de perfil, aparte del perfil para no descargarla al leer el nombre.
    // Máx. 200 000 caracteres: se reduce a 320 px antes de subirla.
    match /userPhotos/{uid} {
      allow get: if autenticado();
      allow create, update: if autenticado() && request.auth.uid == uid
        && request.resource.data.data is string
        && request.resource.data.data.size() <= 200000;
      allow delete: if autenticado() && request.auth.uid == uid;
    }

    // El id es "{orchardId}_{email}": una invitación por persona y huerto, y las
    // reglas del huerto pueden localizarla al aceptar.
    match /invitations/{invitationId} {
      function invitacionValida() {
        let d = request.resource.data;
        let h = huertoDe(d.orchardId);
        return autenticado()
          && invitationId == d.orchardId + '_' + d.email
          && d.email == d.email.lower()
          && d.status == 'pending'
          && d.invitedBy == request.auth.uid
          && tienePermiso(h, 'inviteMembers')
          && (d.role in ['colaborador', 'lector']
              || (d.role == 'administrador' && esAdminDe(h)));
      }
      function respuestaValida() {
        return autenticado() && emailVerificado()
          && resource.data.email == miEmail()
          && resource.data.status == 'pending'
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'respondedAt'])
          && request.resource.data.status in ['accepted', 'rejected'];
      }

      allow read: if autenticado()
        && ((emailVerificado() && resource.data.email == miEmail())
            || esMiembroDe(huertoDe(resource.data.orchardId)));
      allow create: if invitacionValida();
      allow update: if invitacionValida() || respuestaValida();
      allow delete: if autenticado()
        && (resource.data.invitedBy == request.auth.uid
            || esAdminDe(huertoDe(resource.data.orchardId)));
    }

    match /orchards/{orchardId} {
      function propietarioActualiza() {
        let n = request.resource.data;
        return resource.data.ownerId == request.auth.uid
          && n.ownerId == request.auth.uid
          && (!('memberIds' in n)
              || (miembrosCoherentes(n)
                  && request.auth.uid in n.memberIds
                  && n.members[request.auth.uid].role == 'propietario'));
      }
      // Ceder el huerto a otro miembro: quien lo cede pasa a ser administrador.
      function propietarioCede() {
        let v = resource.data;
        let n = request.resource.data;
        return v.ownerId == request.auth.uid
          && n.ownerId != request.auth.uid
          && n.ownerId in v.memberIds
          && n.diff(v).affectedKeys().hasOnly(['ownerId', 'members'])
          && n.members.diff(v.members).affectedKeys().hasOnly([request.auth.uid, n.ownerId])
          && n.members[n.ownerId].role == 'propietario'
          && n.members[request.auth.uid].role == 'administrador'
          && n.members[request.auth.uid].permissions == permisosRol('administrador');
      }
      // Un administrador gestiona todo, salvo la entrada del propietario.
      function administradorActualiza() {
        let v = resource.data;
        let n = request.resource.data;
        return v.ownerId != request.auth.uid
          && v.members[request.auth.uid].role == 'administrador'
          && n.ownerId == v.ownerId
          && miembrosCoherentes(n)
          && n.members[v.ownerId] == v.members[v.ownerId];
      }
      // Cualquier miembro puede irse, pero solo puede quitarse a sí mismo.
      function miembroAbandona() {
        let v = resource.data;
        let n = request.resource.data;
        return v.ownerId != request.auth.uid
          && request.auth.uid in v.memberIds
          && n.diff(v).affectedKeys().hasOnly(['memberIds', 'members'])
          && n.memberIds == v.memberIds.removeAll([request.auth.uid])
          && n.members.diff(v.members).affectedKeys().hasOnly([request.auth.uid])
          && !(request.auth.uid in n.members);
      }
      // Aceptar: solo con una invitación pendiente para mi email verificado, con
      // el rol invitado y sus permisos por defecto. Una invitación ya usada no
      // sirve para volver a entrar tras ser expulsado.
      function invitadoAcepta() {
        let v = resource.data;
        let n = request.resource.data;
        let inv = get(/databases/$(database)/documents/invitations/$(orchardId + '_' + miEmail())).data;
        return emailVerificado()
          && !(request.auth.uid in v.memberIds)
          && inv.status == 'pending'
          && inv.orchardId == orchardId
          && n.diff(v).affectedKeys().hasOnly(['memberIds', 'members'])
          && n.memberIds == v.memberIds.concat([request.auth.uid])
          && n.members.diff(v.members).affectedKeys().hasOnly([request.auth.uid])
          && n.members[request.auth.uid].role == inv.role
          && n.members[request.auth.uid].permissions == permisosRol(inv.role);
      }

      // Consultas de la app: where('ownerId', '==', uid) y
      // where('memberIds', 'array-contains', uid). Cada una cumple una rama.
      allow read: if autenticado()
        && (resource.data.ownerId == request.auth.uid
            || request.auth.uid in resource.data.memberIds);
      allow create: if autenticado()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.memberIds == [request.auth.uid]
        && request.resource.data.members.size() == 1
        && request.resource.data.members[request.auth.uid].role == 'propietario';
      allow update: if autenticado()
        && (propietarioActualiza() || propietarioCede() || administradorActualiza()
            || miembroAbandona() || invitadoAcepta());
      allow delete: if autenticado() && resource.data.ownerId == request.auth.uid;

      function miembro() {
        return autenticado() && esMiembroDe(huertoDe(orchardId));
      }
      function puede(permiso) {
        return autenticado() && tienePermiso(huertoDe(orchardId), permiso);
      }
      function admin() {
        return autenticado() && esAdminDe(huertoDe(orchardId));
      }

      match /crops/{cropId} {
        allow read: if miembro();
        allow write: if puede('manageCrops');
      }

      match /tasks/{taskId} {
        function rutaTarea(id) {
          return /databases/$(database)/documents/orchards/$(orchardId)/tasks/$(id);
        }
        // Completar o desmarcar. Si al completarla se enlaza la siguiente
        // (tarea que se repite), esa siguiente tiene que crearse en el mismo lote.
        function soloCompletar() {
          let cambios = request.resource.data.diff(resource.data).affectedKeys();
          return cambios.hasOnly(['completada', 'completadaEl', 'siguienteId'])
            && (!cambios.hasAny(['siguienteId'])
                || (!('siguienteId' in resource.data)
                    && request.resource.data.completada == true
                    && getAfter(rutaTarea(request.resource.data.siguienteId)).data.anteriorId == taskId));
        }
        // La siguiente de una tarea que se repite: copia de la anterior con otra
        // fecha, creada en el mismo lote en que se completa la anterior. Así quien
        // solo puede completar tareas no puede crear otras a su gusto.
        function esSiguiente() {
          let n = request.resource.data;
          let antes = get(rutaTarea(n.anteriorId)).data;
          let despues = getAfter(rutaTarea(n.anteriorId)).data;
          return n.keys().hasOnly(['titulo', 'descripcion', 'cropId', 'fecha', 'frecuencia',
                                   'responsable', 'completada', 'anteriorId', 'createdAt'])
            && antes.completada == false
            && !('siguienteId' in antes)
            && despues.completada == true
            && despues.siguienteId == taskId
            && antes.get('frecuencia', '') != ''
            && n.frecuencia == antes.frecuencia
            && n.titulo == antes.titulo
            && n.descripcion == antes.get('descripcion', '')
            && n.cropId == antes.get('cropId', null)
            && n.responsable == antes.get('responsable', '')
            && n.completada == false
            && n.fecha is string;
        }

        allow read: if miembro();
        allow create: if puede('manageTasks') || (puede('completeTasks') && esSiguiente());
        allow delete: if puede('manageTasks');
        // "Completar" y "gestionar" son permisos independientes.
        allow update: if (puede('completeTasks') && soloCompletar())
          || (puede('manageTasks')
            && !request.resource.data.diff(resource.data).affectedKeys()
                  .hasAny(['completada', 'completadaEl', 'siguienteId']));
      }

      match /sensors/{sensorId} {
        allow read: if miembro();
        allow write: if puede('manageSensors');
        match /readings/{readingId} {
          allow read: if miembro();
          allow write: if puede('manageSensors');
        }
      }

      match /posts/{postId} {
        allow read: if miembro();
        allow create: if puede('publishPosts')
          && request.resource.data.autorId == request.auth.uid;
        allow delete: if admin()
          || (puede('publishPosts') && resource.data.autorId == request.auth.uid);
      }

      // Una imagen por documento (ver src/utils/imagen.js). Máx. 1 000 000 de
      // caracteres en base64 para no acercarse al límite de 1 MiB de Firestore.
      match /photos/{photoId} {
        function puedeSubirFotos() {
          return admin() || puede('manageCrops') || puede('publishPosts');
        }
        allow read: if miembro();
        allow create: if puedeSubirFotos()
          && request.resource.data.uploadedBy == request.auth.uid
          && request.resource.data.data is string
          && request.resource.data.data.size() <= 1000000;
        allow delete: if admin()
          || (puedeSubirFotos() && resource.data.uploadedBy == request.auth.uid);
      }
    }
  }
}
