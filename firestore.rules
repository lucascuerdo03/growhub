rules_version = '2';

// Reglas de GrowHub: cada usuario solo accede a sus propios huertos
// (y a todas sus subcolecciones). Simple y robusto.
// Pégalas en: Firebase Console > Firestore Database > Reglas > Publicar.
service cloud.firestore {
  match /databases/{database}/documents {

    match /orchards/{orchardId} {
      allow read, update, delete: if request.auth != null
        && resource.data.ownerId == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid;

      function esDueno() {
        return request.auth != null
          && get(/databases/$(database)/documents/orchards/$(orchardId)).data.ownerId == request.auth.uid;
      }

      match /crops/{cropId}    { allow read, write: if esDueno(); }
      match /tasks/{taskId}    { allow read, write: if esDueno(); }
      match /posts/{postId}    { allow read, write: if esDueno(); }
      match /sensors/{sensorId} {
        allow read, write: if esDueno();
        match /readings/{readingId} { allow read, write: if esDueno(); }
      }
    }
  }
}
