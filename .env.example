# Copia este archivo a .env y rellénalo con la configuración web de tu proyecto
# (Firebase Console > Configuración del proyecto > General > Tus apps > SDK).
# .env no se sube al repositorio. Para el modo emulador no hace falta.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=tu-proyecto
VITE_FIREBASE_STORAGE_BUCKET=tu-proyecto.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
