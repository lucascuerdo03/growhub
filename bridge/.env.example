# Copia este archivo a bridge/.env (que no se sube al repositorio) y rellénalo.

# Identificador del nodo. Pon el mismo en la app, en cada sensor del nodo:
# Huerto > Sensores > "Identificador del nodo".
DEVICE_ID=growhub-nodo-01

# Ruta a la clave de la cuenta de servicio de Firebase, FUERA del repositorio
# (ver bridge/README.md). Por ejemplo:
SERVICE_ACCOUNT_PATH=/Users/tu-usuario/.growhub/clave-firebase.json

# Humedad del suelo: RAW del sensor al aire (0 %) y dentro de un vaso de agua (100 %).
# Si calibras el sensor desde la app ("Guardar como seco / mojado"), mandan esos valores.
# SOIL_RAW_DRY=3300
# SOIL_RAW_WET=1300

# Segundos mínimos entre dos escrituras del mismo sensor (no menos de 15).
# Con 60 s y 3 sensores son unas 4 300 escrituras al día; el plan gratuito
# permite 20 000. Con 15 s serían 17 300 y casi no quedaría margen para la app.
# MIN_INTERVAL_S=60

# Puerto USB del nodo. Vacío: se busca solo (usbmodem, wchusbserial o usbserial).
# SERIAL_PORT=/dev/cu.usbserial-0001
# SERIAL_BAUD=115200

# The Things Network (npm run bridge:ttn).
# TTN_APP_ID=growhub
# TTN_DEVICE_ID=growhub-nodo-01
# TTN_API_KEY=NNSXS.XXXXXXXX

# Para probar contra el emulador local en vez del proyecto real (no necesita clave).
# USE_EMULATOR=true
